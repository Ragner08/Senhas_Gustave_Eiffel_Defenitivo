@model Meal
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Definir Refeição";
    var sopaItems = ViewBag.SopaItems as List<SelectListItem> ?? new List<SelectListItem>();
    var pratoPrincipalItems = ViewBag.PratoPrincipalItems as List<SelectListItem> ?? new List<SelectListItem>();
    var vegetarianoItems = ViewBag.VegetarianoItems as List<SelectListItem> ?? new List<SelectListItem>();
    var sobremesaItems = ViewBag.SobremesaItems as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-utensils me-2"></i>Definir Refeição
                    </h4>
                </div>
                <div class="card-body scrollable-form">
                    <form asp-action="CreateMeal" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <input type="hidden" asp-for="Data" />

                        <div class="form-group">
                            <label asp-for="Data" class="form-label">Data</label>
                            <input type="text" class="form-control" value="@Model.Data.ToString("dddd, dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("pt-PT"))" readonly />
                        </div>

                        <div class="form-group">
                            <label asp-for="Sopa" class="form-label">Sopa</label>
                            @if (sopaItems.Any())
                            {
                                <select asp-for="Sopa" class="form-select" asp-items="sopaItems">
                                    <option value="">-- Selecionar sopa --</option>
                                </select>
                            }
                            else
                            {
                                <input asp-for="Sopa" class="form-control" placeholder="Digite a sopa do dia" />
                            }
                            <span asp-validation-for="Sopa" class="invalid-feedback"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PratoPrincipal" class="form-label">Prato Principal</label>
                            @if (pratoPrincipalItems.Any())
                            {
                                <select asp-for="PratoPrincipal" class="form-select" asp-items="pratoPrincipalItems">
                                    <option value="">-- Selecionar prato principal --</option>
                                </select>
                            }
                            else
                            {
                                <input asp-for="PratoPrincipal" class="form-control" placeholder="Digite o prato principal" />
                            }
                            <span asp-validation-for="PratoPrincipal" class="invalid-feedback"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Vegetariano" class="form-label">Opção Vegetariana</label>
                            @if (vegetarianoItems.Any())
                            {
                                <select asp-for="Vegetariano" class="form-select" asp-items="vegetarianoItems">
                                    <option value="">-- Selecionar opção vegetariana --</option>
                                </select>
                            }
                            else
                            {
                                <input asp-for="Vegetariano" class="form-control" placeholder="Digite a opção vegetariana" />
                            }
                            <span asp-validation-for="Vegetariano" class="invalid-feedback"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Sobremesa" class="form-label">Sobremesa</label>
                            @if (sobremesaItems.Any())
                            {
                                <select asp-for="Sobremesa" class="form-select" asp-items="sobremesaItems">
                                    <option value="">-- Selecionar sobremesa --</option>
                                </select>
                            }
                            else
                            {
                                <input asp-for="Sobremesa" class="form-control" placeholder="Digite a sobremesa" />
                            }
                            <span asp-validation-for="Sobremesa" class="invalid-feedback"></span>
                        </div>

                        <div class="alert alert-info">
                            <strong>Nota:</strong> Defina comidas em <a asp-controller="Foods" asp-action="Index">Comidas</a> para usar as opções prontas.
                        </div>

                        <hr class="my-4" />

                        <h6 class="mb-3"><i class="bi bi-cash me-2"></i>Preços</h6>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="PrecoEscalaoA" class="form-label">Escalão A</label>
                                    <input asp-for="PrecoEscalaoA" class="form-control" type="number" step="0.01" readonly />
                                    <small class="form-text">Preço fixo: 0,00 €</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="PrecoEscalaoB" class="form-label">Escalão B</label>
                                    <input asp-for="PrecoEscalaoB" class="form-control" type="number" step="0.01" readonly />
                                    <small class="form-text">Preço fixo: 0,73 €</small>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="PrecoSemEscalao" class="form-label">Sem Escalão</label>
                                    <input asp-for="PrecoSemEscalao" class="form-control" type="number" step="0.01" readonly />
                                    <small class="form-text">Preço fixo: 1,46 €</small>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle me-2"></i>Guardar Refeição
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Voltar ao Calendário
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
