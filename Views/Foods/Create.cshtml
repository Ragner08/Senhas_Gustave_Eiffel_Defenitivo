@*
    Vista: Formulário para criar um novo `FoodItem` (Sopa, Prato Principal, Vegetariano, Sobremesa).
    Usado por Admin/Funcionário para definir itens reutilizáveis nos menus.
*@
@model Senhas_Gustave_Eiffel.Models.FoodItem
@{
    ViewData["Title"] = "Adicionar Comida";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-plus-circle me-2"></i>Adicionar Comida
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <div class="form-group">
                            <label asp-for="Categoria" class="form-label">Categoria</label>
                            <select asp-for="Categoria" class="form-select">
                                <option value="">Selecione a categoria</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <span asp-validation-for="Categoria" class="invalid-feedback"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Nome" class="form-label">Nome da Comida</label>
                            <input asp-for="Nome" class="form-control" placeholder="Digite o nome da comida" />
                            <span asp-validation-for="Nome" class="invalid-feedback"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-save me-2"></i>Guardar Comida
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Voltar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
