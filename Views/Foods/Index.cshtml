@*
    Vista: Lista de `FoodItem` usados para compor menus.
    Mostra categorias e nomes; permite navegar para criar novo item.
*@
@model List<Senhas_Gustave_Eiffel.Models.FoodItem>
@{
    ViewData["Title"] = "Comidas Definidas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-list-check me-2"></i>Comidas Definidas
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>Adicionar Comida
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end mb-4">
                <div class="col-md-8">
                    <label for="searchTerm" class="form-label">Pesquisar por nome</label>
                    <input type="text" class="form-control" id="searchTerm" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Digite o nome da comida" />
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-2"></i>Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-2"></i>Limpar
                    </a>
                </div>
            </form>

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Categoria</th>
                                <th>Nome</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var food in Model)
                            {
                                <tr>
                                    <td>@food.Categoria</td>
                                    <td>@food.Nome</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-inbox fs-1"></i>
                    <p class="mt-2">Ainda não existem comidas definidas.</p>
                </div>
            }
        </div>
    </div>
</div>
